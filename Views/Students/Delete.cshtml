@model Student

@{
    ViewData["Title"] = "Delete Student";
}

<div class="form-panel">
    <h1>Delete Student</h1>
    <p>Are you sure you want to delete <strong>@Model.Name</strong>?</p>
    <dl class="row">
        <dt class="col-sm-3">Register Number</dt>
        <dd class="col-sm-9">@Model.RegisterNumber</dd>
        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Email</dd>
    </dl>
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button class="btn btn-danger" type="submit">Delete</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
    </form>
</div>
