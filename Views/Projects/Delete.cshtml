@model ProjectSubmission

@{
    ViewData["Title"] = "Delete Submission";
}

<div class="form-panel">
    <h1>Delete Project Submission</h1>
    <p>Are you sure you want to delete <strong>@Model.ProjectTitle</strong>?</p>
    <dl class="row">
        <dt class="col-sm-3">Student</dt>
        <dd class="col-sm-9">@Model.Student?.Name</dd>
        <dt class="col-sm-3">Guide</dt>
        <dd class="col-sm-9">@Model.FacultyGuide?.Name</dd>
        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>
    </dl>
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button class="btn btn-danger" type="submit">Delete</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
    </form>
</div>
